    "h3": "^1.15.11",
    "ioredis": "^5.11.1",
    "lodash-es": "^4.17.21",
    "nitropack": "^2.13.4",
    "nuxt": "4.5.1",
    "nuxt-delay-hydration": "^1.3.3",
    "nuxt-typed-router": "^3.6.3",
    "nuxt-viewport": "^2.6.1",
    "object-hash": "^3.0.0",
    "ofetch": "^1.5.1",
    "unstorage": "^1.17.5",
    "vue-router": "^4.3.2",
    "vue-toastification": "next"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@eslint/js": "^9.17.0",
    "@graphql-codegen/cli": "^6.1.0",
    "@graphql-codegen/client-preset": "^4.0.1",
    "@graphql-codegen/typescript": "^4.0.1",
