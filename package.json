      "tailwindcss": "~3.4.17",
      "defu": "^6.1.5",
      "lodash": "^4.18.0",
      "lodash-es": "^4.18.0",
      "nanoid": "^3.3.8",
      "immutable": "^3.8.3",
      "srvx": "^0.11.13",
      "esbuild": "^0.28.1",
      "axios": "^0.34.0",
      "nuxt": "4.5.1",
      "sharp": "^0.35.5"
    }
