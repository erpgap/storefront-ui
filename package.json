    "@nuxt/scripts": "^0.11.1",
    "@nuxtjs/google-fonts": "^3.2.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/robots": "^5.6.7",
    "@nuxtjs/sitemap": "^8.2.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@pinia/nuxt": "^0.5.1",
    "@storefront-ui/typography": "^2.6.1",
    "@storefront-ui/vue": "^2.6.3",
    "@stripe/stripe-js": "^9.8.0",
    "@types/lodash-es": "^4.17.12",
    "@vue-storefront/sdk": "^2.0.0",
