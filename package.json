    "@nuxt/eslint": "^0.7.4",
    "@playwright/test": "^1.63.0",
    "@types/object-hash": "^3.0.6",
    "dotenv": "^17.4.2",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "git-cz": "^4.9.0",
    "husky": "^9.0.11",
    "tailwindcss": "~3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.18.1",
    "vitest": "^5.0.3",
    "vue": "^3.5.22",
    "vue-tsc": "^3.2.5"
