ARG NODE_VERSION=22.22
ARG PNPM_VERSION=10.18.3
ARG SAAS_MODE=false
ARG NUXT_PUBLIC_ODOO_BASE_URL="https://vsfdemo15.labs.odoogap.com/"
ARG NUXT_PUBLIC_ODOO_BASE_IMAGE_URL="https://vsfdemo15.labs.odoogap.com/"
ARG NUXT_PUBLIC_MIDDLEWARE_URL="http://localhost:3000/"
ARG NUXT_PUBLIC_MIDDLEWARE_PORT=8443
ARG NUXT_PUBLIC_VSF_PORT=3000
ARG REDIS_URL="redis://redis:6379"
ARG NUXT_ALGOLIA_API_KEY="change_api_key"
ARG NUXT_ALGOLIA_APPLICATION_ID="change_application_id"
ARG PORT=3000

FROM node:${NODE_VERSION}-slim as base

ARG NUXT_ALGOLIA_API_KEY
ARG NUXT_ALGOLIA_APPLICATION_ID
ARG NUXT_PUBLIC_ODOO_BASE_URL
ARG NUXT_PUBLIC_ODOO_BASE_IMAGE_URL
ARG NUXT_PUBLIC_MIDDLEWARE_URL
ARG NUXT_PUBLIC_MIDDLEWARE_PORT
ARG REDIS_URL
ARG SAAS_MODE
ARG NUXT_PUBLIC_VSF_PORT

ENV NODE_ENV=production
ENV NUXT_PUBLIC_ODOO_BASE_URL=${NUXT_PUBLIC_ODOO_BASE_URL}
ENV NUXT_PUBLIC_ODOO_BASE_IMAGE_URL=${NUXT_PUBLIC_ODOO_BASE_IMAGE_URL}
ENV NUXT_PUBLIC_MIDDLEWARE_URL=${NUXT_PUBLIC_MIDDLEWARE_URL}
ENV NUXT_PUBLIC_MIDDLEWARE_PORT=${NUXT_PUBLIC_MIDDLEWARE_PORT}
ENV NUXT_PUBLIC_VSF_PORT=${NUXT_PUBLIC_VSF_PORT}
ENV REDIS_URL=${REDIS_URL}
ENV NUXT_STORAGE_DRIVER=redis
ENV NUXT_STORAGE_URL=${REDIS_URL}
ENV NUXT_STORAGE_URL_BUILD=${REDIS_URL}
ENV NUXT_STORAGE_INVALIDATION_KEY=build-placeholder
ENV NUXT_CACHE_INVALIDATION_KEY=build-placeholder
ENV NUXT_CACHE_INVALIDATION_SIGNING_SECRET=build-placeholder
ENV NUXT_NODE_LOCALE=en-EN
ENV NUXT_SWR_CACHE_TIME=3600
ENV NUXT_ZEPPLN_TOKEN=build-placeholder
ENV NUXT_STORYBLOK_TOKEN=
ENV NUXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=
ENV NUXT_PUBLIC_CURRENCY_SEPARATOR=,
ENV NUXT_PUBLIC_CURRENCY_DECIMAL=.
ENV NUXT_PUBLIC_CURRENCY_SYMBOL=$
ENV NUXT_PUBLIC_CURRENCY_PRECISION=2
ENV NUXT_PUBLIC_CATEGORY_PAGE_SIZE=10000
ENV NUXT_PUBLIC_PRODUCT_PAGE_SIZE=10000
ENV NUXT_PUBLIC_CATEGORY_PAGE_FILE=~/layers/category/pages/category/[id].vue
ENV NUXT_PUBLIC_PRODUCT_PAGE_FILE=~/layers/product/pages/product/[slug].vue
ENV SEO_INDEXING_ENABLED=0
ENV NUXT_TELEMETRY_DISABLED=1
ENV NUXT_ALGOLIA_API_KEY=${NUXT_ALGOLIA_API_KEY}
ENV NUXT_ALGOLIA_APPLICATION_ID=${NUXT_ALGOLIA_APPLICATION_ID}
ENV SAAS_MODE=${SAAS_MODE}

RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
WORKDIR /src

# Build
FROM base as build

ENV NODE_ENV=development
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --prod=false

COPY . ./
RUN pnpm build

# Run
FROM base

ARG PORT
ENV PORT=$PORT
ENV NODE_ENV=production
ENV NUXT_ALGOLIA_API_KEY=${NUXT_ALGOLIA_API_KEY}
ENV NUXT_ALGOLIA_APPLICATION_ID=${NUXT_ALGOLIA_APPLICATION_ID}
ENV NUXT_TELEMETRY_DISABLED=1

COPY --from=build /src/.output ./
COPY .docker/runtime-config.saas.mjs /src/runtime-config.saas.mjs

EXPOSE $PORT

CMD ["sh", "-lc", "if [ \"$SAAS_MODE\" = \"true\" ]; then node /src/runtime-config.saas.mjs; else node /src/server/index.mjs; fi"]
